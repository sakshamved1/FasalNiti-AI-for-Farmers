
# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB connection string, or leave blank to use automatic in-memory DB)
MONGO_URI=

# Authentication Secret
JWT_SECRET=replace_with_a_long_random_secret

# AI / ML API Keys (Optional - falls back to built-in high accuracy agricultural model)
AI_API_KEY=

# Cloudinary / Image Storage (Optional - fallback to local base64 preview)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Map API Key (Optional - OpenStreetMap Leaflet uses public tiles by default)
MAP_API_KEY=

# Firebase Notifications Config (Optional)
FIREBASE_CONFIG={"apiKey":"","projectId":"","messagingSenderId":"","appId":""}
